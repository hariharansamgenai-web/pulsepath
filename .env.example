# Supabase configuration — these are pre-populated in the hosted environment.
# For local development, copy this file to `.env` and fill in your project's values.
# NEVER commit your actual `.env` file.

# Public Supabase URL (safe for the browser)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe for the browser with RLS enforced)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-side only (NEVER expose to the browser, no VITE_ prefix) ---
# These are pre-populated in the hosted environment and used by Edge Functions.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_DB_URL=your-database-url
# OPENAI_API_KEY=your-openai-api-key
